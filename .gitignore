# Git tracks only essentials: code, configs, docs, and small result summaries.
# Large binaries (checkpoints, per-episode logs) stay on disk / Great Lakes or go on a GitHub release.

# Python / build
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*:Zone.Identifier

# Local secrets and per-user tool settings
.env
.claude/settings.local.json

# MATLAB autosaves and workspaces
*.asv
*.mat
slprj/

# Working outputs: training runs, tracking tests, job logs
runs/
slurm-*.out
*.log

# Large binaries, everywhere (including result snapshots): checkpoints and per-episode logs
*.zip
*.npz
# ...except the curated human driving demos (scripts/drive.py): small, tracked for imitation learning
!data/human_demos/*.npz
# ...and the behaviour-cloning clone used as the PPO warm start (scripts/bc.py; training.init_policy)
!data/bc/*.zip
*.pt
*.pth
*.ckpt

# Result snapshots (<MM_DD>_data/): commit configs, summaries (csv/txt/md), plots and job logs only.
!/[0-9][0-9]_[0-9][0-9]_data/**/*.out

# Figures go in a snapshot's plots/ folder, not the repo root
/*.png

Nav565-Team16-ProjectProposal.pdf