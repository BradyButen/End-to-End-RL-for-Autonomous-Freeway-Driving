# Git tracks code, configs, docs, the human drives, the M1 clone and the final models. Training outputs stay local.

# Python / build
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*:Zone.Identifier

# Local secrets and per-user tool settings
.env
.claude/

# Outputs: training runs, viewer reports, drives, Slurm logs
runs/
slurm-*.out
*.log
/*.png
*.pdf

# Large binaries, except the curated ones below
*.zip
*.npz
*.pt
*.pth
*.ckpt
# human drives (scripts/warm_start/drive.py): the behaviour-cloning data
!data/human_demos/*.npz
# the M1 clone (scripts/warm_start/bc.py): the PPO warm start
!data/bc/*.zip
# the final trained policies
!models/*/checkpoints/best.zip
